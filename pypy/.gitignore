# ===== Python 虚拟环境：绝对不要提交 =====
# .venv 体积 109MB、包含 9500+ 个文件，会让 Git 和 GitHub 直接卡死
.venv/
venv/
env/
ENV/

# ===== Python 编译产物与缓存 =====
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ===== Jupyter 检查点 =====
.ipynb_checkpoints/

# ===== 敏感信息：绝不入库 =====
.env
.env.*
*.key
*.pem
secrets.*
credentials*

# ===== 编辑器与系统 =====
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini
*.tmp
*.log
